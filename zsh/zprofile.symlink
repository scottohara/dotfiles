########################################################
# This file loads shared zsh settings for login shells #
########################################################

# To enable xtrace debugging, uncomment the next 3 lines (and 2 more at the end)
#PS4=$'\\\011%D{%s%6.}\011%x\011%I\011%N\011%e\011'
#exec 3>&2 2>/tmp/zshstart.$$.log
#setopt xtrace prompt_subst

# To enable profiling of shell startup time (`zprof`), uncomment the next line
#zmodload zsh/zprof

# Temporarily suppress any errors if nothing matches a glob
setopt null_glob

# Load shared shell-agnostic settings for login shells
source ~/.profile

# Restore errors if nothing matches a glob
unsetopt null_glob

# To enable xtrace debugging, uncomment the next two lines
#unsetopt xtrace
#exec 2>&3 3>&-

# Load non-shared zsh settings for login shells
[[ -f ~/.zprofile.local ]] && source ~/.zprofile.local