#########################################################
# This file loads shared bash settings for login shells #
#########################################################

# Load shared bash settings for all shell modes
source ~/.bashenv
export BASH_ENV="$HOME/.bashenv"

# Temporarily suppress any errors if nothing matches a glob
shopt -s nullglob

# Load shared shell-agnostic settings for login shells
source ~/.profile

# Restore errors if nothing matches a glob
shopt -u nullglob

# Load shared bash settings for interactive shells
# (a guard in that file exits early if not interactive)
source ~/.bashrc

# Load non-shared bash settings for login shells
[[ -f ~/.bash_profile.local ]] && source ~/.bash_profile.local